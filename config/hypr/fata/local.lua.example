-- Pick exactly one acceleration policy only after testing it with the 1200 DPI
-- mouse. Empty accel_profile in the portable config leaves libinput's default.
-- hl.config({ input = { accel_profile = "flat", sensitivity = 0.0 } })
-- hl.config({ input = { accel_profile = "adaptive", sensitivity = 0.0 } })

